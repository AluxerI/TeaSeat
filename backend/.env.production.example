APP_NAME=TeaSeat
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Moscow
APP_URL=https://example.ru
FRONTEND_URL=https://example.ru

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=teaseat
DB_USERNAME=teaseat
DB_PASSWORD=change-me

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=930

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=example.ru
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=example.ru,www.example.ru

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
OCTANE_SERVER=roadrunner

DELIVERY_BOOKING_HORIZON_DAYS=30
COURIER_CLAIM_LEAD_HOURS=24
SELLER_PRICE_SNAPSHOT_TTL_HOURS=48
SELLER_CLOCK_SKEW_MINUTES=5

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TeaSeat
