# Меняем версию PHP с 8.2 на 8.3
FROM php:8.3-cli AS base

# Установка системных зависимостей
RUN apt-get update -y && apt-get install -y \
    libonig-dev \
    openssl \
    zip \
    unzip \
    git \
    libpq-dev \
    libzip-dev \
    libicu-dev \
    curl \
    && docker-php-ext-install \
    pdo \
    mbstring \
    pdo_pgsql \
    zip \
    intl \
    opcache \
    pcntl \
    sockets \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Установка Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /app/backend

# Копируем composer файлы
COPY composer.json composer.lock ./

# Устанавливаем зависимости (без скриптов)
RUN composer install --no-interaction --prefer-dist --optimize-autoloader --no-scripts

# Копируем остальной код
COPY . .

# Запускаем скрипты после копирования всего кода
RUN composer run-script post-autoload-dump || true

# Создаем .rr.yaml если его нет
RUN if [ ! -f .rr.yaml ]; then \
    php artisan octane:install --server=roadrunner --no-interaction; \
    fi

# Права на storage
RUN chown -R www-data:www-data storage bootstrap/cache || true

EXPOSE 8000 6001

# Запуск через RoadRunner
CMD ["bash", "-c", "composer install && php artisan octane:start --server=roadrunner --host=0.0.0.0 --port=8000"]