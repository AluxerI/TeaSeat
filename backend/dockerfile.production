# syntax=docker/dockerfile:1.7

FROM php:8.3-cli-bookworm AS php-base

ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_HOME=/tmp/composer

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libfreetype6-dev \
        libicu-dev \
        libjpeg62-turbo-dev \
        libonig-dev \
        libpng-dev \
        libpq-dev \
        libzip-dev \
        unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" \
        gd \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo_pgsql \
        sockets \
        zip \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app/backend

FROM php-base AS vendor

COPY composer.json composer.lock ./

RUN --mount=type=cache,target=/tmp/composer-cache \
    COMPOSER_CACHE_DIR=/tmp/composer-cache composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --prefer-dist \
        --classmap-authoritative

FROM php-base AS production

COPY docker/php/production.ini /usr/local/etc/php/conf.d/99-teaseat-production.ini
COPY --chown=www-data:www-data . .
COPY --from=vendor --chown=www-data:www-data /app/backend/vendor ./vendor

RUN rm -f .env bootstrap/cache/*.php \
    && chmod 0755 rr docker/entrypoint.production.sh \
    && mkdir -p \
        bootstrap/cache \
        storage/app/imports \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
    && rm -rf public/storage \
    && ln -s ../storage/app/public public/storage \
    && composer dump-autoload \
        --no-dev \
        --no-interaction \
        --no-scripts \
        --classmap-authoritative \
    && php artisan package:discover --ansi \
    && chown -R www-data:www-data bootstrap/cache storage

USER www-data

EXPOSE 8000 6001

ENTRYPOINT ["./docker/entrypoint.production.sh"]
CMD ["php", "artisan", "octane:start", "--server=roadrunner", "--host=0.0.0.0", "--port=8000", "--workers=4", "--max-requests=500"]
