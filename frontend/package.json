    "@fontsource-variable/unbounded": "^5.3.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.7",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^6.12.6",
    "axios": "^1.13.4",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.18.0",
    "query-string": "^9.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.13.0",
    "three": "^0.185.1",
    "typescript": "^5.7.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:courier": "vitest run src/courier src/pages/courier src/components/courier",
    "test:picker": "vitest run src/picker src/pages/picker",
    "test:manager": "vitest run src/manager src/staff src/pages/manager src/components/manager src/contexts/ManagerContext.test.tsx",
    "test:offline": "vitest run src/pwa src/hooks/useOnlineStatus.test.tsx src/picker/PickerContext.test.tsx src/courier/cache.test.ts src/courier/CourierContext.test.tsx src/pages/picker/PickerOrderPage.test.tsx src/pages/picker/PickerTransfersPage.test.tsx src/components/constructor/StageThree.test.tsx",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:e2e:offline": "playwright test --grep @offline",
    "test:regression": "vitest run && playwright test --grep @regression",
    "test:all": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "sass": "^1.89.2",
    "vitest": "^4.1.10"
  }
}
